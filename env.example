# ─────────────────────────────────────────────────────────────
# Emi YouTube Analytics — variáveis de ambiente
#
# Copie este arquivo para .env e preencha com os valores reais.
#   cp .env.example .env
#
# O .env NUNCA deve ser commitado (já está no .gitignore).
# ─────────────────────────────────────────────────────────────

# ── BANCO DE DADOS ───────────────────────────────────────────
# Supabase > botão "Connect" > aba "Session pooler" (porta 5432)
# Copie a string EXATA do painel e troque [YOUR-PASSWORD] pela senha do projeto.
# Prefixo postgresql+asyncpg:// porque o backend usa SQLAlchemy assíncrono.
DATABASE_URL=postgresql+asyncpg://[usuario]:[senha]@[host]:5432/postgres

# ── AUTENTICAÇÃO (JWT emitido pelo próprio backend) ──────────
# Gere com:  openssl rand -hex 32
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── API EXTERNA CONSUMIDA EM PRODUÇÃO ────────────────────────
# Google Cloud Console > APIs e Serviços > Credenciais
YOUTUBE_API_KEY=

# ── APLICAÇÃO ────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
# Origens permitidas no CORS (frontend Angular)
CORS_ORIGINS=http://localhost:4200

# ── EMPRESAS E E-MAIL (convites e redefinição de senha) ─────
# Teto de membros por empresa, contando convites pendentes.
EMPRESA_MAX_MEMBROS=10
# "log" (padrao): nao envia; em desenvolvimento o e-mail, com o link, vai para o log.
# "resend": envia pela API do Resend (docs/DEPLOY.md, passo B.2).
EMAIL_PROVEDOR=log
# Segredo: nunca commite.
RESEND_API_KEY=
# Remetente verificado no Resend. Sem dominio verificado so entrega para o e-mail da conta.
EMAIL_REMETENTE=Emi Analytics <onboarding@resend.dev>
# Base dos links que vao no e-mail (convite e redefinicao de senha): a URL do
# frontend, com https e SEM barra no fim. Em producao e o dominio da Vercel; o
# padrao localhost ali gera links quebrados, e a API avisa (WARNING) no arranque.
FRONTEND_URL=http://localhost:4200

# ── WORKERS ──────────────────────────────────────────────────
WORKER_POLL_INTERVAL_SECONDS=5
WORKER_MAX_RETRIES=4

# Arquivo do SentiLex-PT02, carregado pelo classificador lexico do worker de
# inferencia. NAO e segredo: e dado de terceiro (CC-BY 4.0, 6,9 MB) que fica fora do
# git, como o corpus. Deixe em branco para usar o padrao, que aponta para onde o
# experimento do ml/ o baixa (ml/lexico/dados/SentiLex-flex-PT02.txt); num deploy sem
# a pasta ml/, aponte para o arquivo. Como baixar: ml/lexico/README.md.
# O sha256 e conferido ao iniciar o worker -- arquivo diferente do medido no Capitulo
# 5 e falha de inicializacao, nao classificacao silenciosamente diferente.
SENTILEX_PATH=

# BERTimbau, o classificador de PRODUCAO do worker de inferencia. Os pesos (~420 MB)
# ficam fora do git. Em branco, BERTIMBAU_PATH usa ml/modelos/bertimbau-2026-09-30;
# no Azure, aponte para /home/modelos/bertimbau-emi-1.0.0 (sobrevive a restart).
# O sha256 de cada arquivo e conferido ao iniciar o worker contra
# backend/app/inferencia/bertimbau_manifesto.json. Se o modelo nao subir por qualquer
# motivo, o worker usa o lexico acima e registra o motivo no log.
BERTIMBAU_PATH=
# De onde `python -m app.inferencia.baixar_bertimbau` baixa (docs/DEPLOY.md):
# repositorio PRIVADO do Hugging Face Hub, ex.: emi-youtube/bertimbau-emi
BERTIMBAU_REPO_HF=
BERTIMBAU_REVISAO_HF=main
# Token de LEITURA (fine-grained, so esse repositorio). E segredo: nunca commite.
HF_TOKEN=

# ─────────────────────────────────────────────────────────────
# NÃO COLOQUE A CHAVE DA GEMINI AQUI.
# Ela é segredo do ambiente de TREINO (ml/ e Colab), não de produção.
# A aplicação em produção não armazena chave de LLM de terceiro —
# isso é parte da conformidade com a LGPD defendida no TCC.
# Use um .env separado dentro de ml/ ou configure direto no Colab.
# ─────────────────────────────────────────────────────────────
