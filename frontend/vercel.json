{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/emi-frontend/browser",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/v1/:caminho*",
      "destination": "https://emi-youtube-hzfzgfc2gfdsfydu.mexicocentral-01.azurewebsites.net/api/v1/:caminho*"
    },
    {
      "source": "/(.*)",
      "destination": "/api/ssr"
    }
  ],
  "functions": {
    "api/ssr.mjs": {
      "includeFiles": "dist/emi-frontend/server/**"
    }
  }
}
